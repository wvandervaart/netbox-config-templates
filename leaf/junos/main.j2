{# fetched once and reused by every include below - avoids re-querying + N+1 lookups per partial #}
{% set device_interfaces = device.interfaces.all().select_related('vrf', 'untagged_vlan', 'lag', 'parent').prefetch_related('tagged_vlans', 'tags', 'ip_addresses', '_path', 'cable__terminations') | list %}
{# device-scope maintenance flag - kept in sync with the identical copies in the other 3 junos mains #}
{% set is_maintenance = "maintenance" in device.tags.names() %}
{# site-scoped maintenance VLAN - kept in sync with the identical copies in the other 4 junos mains #}
{% set maintenance_vlan = ipam.VLAN.objects.filter(tags__name='maintenance').first() %}
{# ESI custom objects (netbox_custom_objects plugin) link an ethernet-segment to the interfaces sharing it - map interface.id -> esi object once here, same rationale as device_interfaces above #}
{% set esi_model = netbox_custom_objects.CustomObjectType.objects.get(name='esi').get_model() %}
{% set esi_by_interface = {} %}
{% for esi in esi_model.objects.filter(interfaces__in=device_interfaces).distinct() %}
    {% for esi_intf in esi.interfaces.all() %}
        {% set _ = esi_by_interface.update({esi_intf.id: esi}) %}
    {% endfor %}
{% endfor %}
