{# -- Collect policies from BGP sessions ------------------------------------ #}
{% set pols = [] %}
{% set pls  = [] %}
{% set policy_sets = [] %}
{% set ns   = namespace(enabled_vrfs=[]) %}
{% for peer in bgp_sessions %}
    {% set _ = policy_sets.append(peer.import_policies.all()) %}
    {% set _ = policy_sets.append(peer.peer_group.import_policies.all()) %}
    {% set _ = policy_sets.append(peer.export_policies.all()) %}
    {% set _ = policy_sets.append(peer.peer_group.export_policies.all()) %}
    {% for policy_set in policy_sets %}
        {% for policy in policy_set %}
            {% if policy not in pols %}
                {% set _ = pols.append(policy) %}
            {% endif %}
        {% endfor %}
    {% endfor %}
{% endfor %}
{# -- Collect enabled VRFs and their export policies ------------------------- #}
{% for interface in device_interfaces %}
    {% if interface.enabled and interface.vrf.id is defined and interface.vrf not in ns.enabled_vrfs %}
        {% set _ = ns.enabled_vrfs.append(interface.vrf) %}
    {% endif %}
{% endfor %}
{% for vrf in ns.enabled_vrfs %}
    {% set vni = vrf.cf.get('VNI') %}
    {% if vni and vni.cf.EXPORT_POLICY is defined and vni.cf.EXPORT_POLICY not in pols %}
        {% set _ = pols.append(vni.cf.EXPORT_POLICY) %}
    {% endif %}
{% endfor %}
{# -- All RoutingPolicy objects by name, fetched once instead of one .get()
   per match_custom "policy" reference below #}
{% set all_policies_by_name = {} %}
{% for rp in netbox_bgp.RoutingPolicy.objects.all() %}
    {% set _ = all_policies_by_name.setdefault(rp.name, rp) %}
{% endfor %}
{# -- Discover prefix-lists referenced by policy rules (no queries yet) ------ #}
{% macro register_pl(pl) %}
    {% if pl not in pls %}
        {% set _ = pls.append(pl) %}
    {% endif %}
{% endmacro %}
{% for poli in pols %}
    {% for rule in poli.rules.all() %}
        {# Side-effect: add linked routing policies discovered via match_custom #}
        {% if rule.match_custom is defined and rule.match_custom is iterable %}
            {% for mc in rule.match_custom %}
                {% if mc.name is defined and mc.name == "policy" %}
                    {% set linked = all_policies_by_name.get(mc.value) %}
                    {% if linked not in pols %}{% set _ = pols.append(linked) %}{% endif %}
                {% endif %}
            {% endfor %}
        {% endif %}
        {# IPv4 prefix-lists #}
        {% if rule.match_ip_address is defined %}
            {% for pl in rule.match_ip_address.all() %}{{ register_pl(pl) }}{% endfor %}
        {% endif %}
        {# IPv6 prefix-lists #}
        {% if rule.match_ipv6_address is defined %}
            {% for pl in rule.match_ipv6_address.all() %}{{ register_pl(pl) }}{% endfor %}
        {% endif %}
    {% endfor %}
{% endfor %}
{# -- Always-add prefix-lists ------------------------------------------------ #}
{% for pl in netbox_bgp.PrefixList.objects.all().prefetch_related('tags') %}
    {% if "ALWAYS_ADD" in pl.tags.names() %}{{ register_pl(pl) }}{% endif %}
{% endfor %}
{# -- Render, one batched PrefixListRule query for every list discovered above,
   instead of one query per distinct prefix-list #}
{% set pl_rules = {} %}
{% for plr in netbox_bgp.PrefixListRule.objects.filter(prefix_list__in=pls) %}
    {% set _ = pl_rules.setdefault(plr.prefix_list.id, []).append(plr) %}
{% endfor %}
{% for pl in pls %}
    {% for plr in pl_rules.get(pl.id, []) %}
set policy-options prefix-list {{ pl.name }} {{ plr.prefix_custom }}
    {% endfor %}
{% endfor %}
